# Cloud credentials required by 'make run' (local development).
# Copy to .env and fill in real values; never commit .env.
# The RAM account needs AliyunNLBFullAccess / AliyunEIPFullAccess / AliyunVPCFullAccess.

# Alibaba Cloud AccessKey ID
ACCESS_KEY_ID=

# Alibaba Cloud AccessKey Secret
ACCESS_KEY_SECRET=

# Alibaba Cloud region, e.g. cn-shanghai / cn-hangzhou
REGION_ID=
